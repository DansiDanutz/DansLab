{
  "_comment": "ComfyUI API-format workflow for V2 character hero shots. FLUX.1-dev + IP-Adapter for style consistency. Run on Mac Studio. The runner script (generate_characters_local.py) patches POSITIVE_PROMPT, NEGATIVE_PROMPT, SEED, and STYLE_REF nodes per character.",
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "_meta": { "title": "EMPTY_LATENT" }
  },
  "10": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-dev.safetensors",
      "weight_dtype": "fp8_e4m3fn"
    },
    "_meta": { "title": "UNET" }
  },
  "11": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "t5xxl_fp8_e4m3fn.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    },
    "_meta": { "title": "CLIP" }
  },
  "12": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "ae.safetensors" },
    "_meta": { "title": "VAE" }
  },
  "20": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["11", 0], "text": "REPLACED_BY_RUNNER" },
    "_meta": { "title": "POSITIVE_PROMPT" }
  },
  "21": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["11", 0], "text": "REPLACED_BY_RUNNER" },
    "_meta": { "title": "NEGATIVE_PROMPT" }
  },
  "30": {
    "class_type": "LoadImage",
    "inputs": { "image": "memo.jpg" },
    "_meta": { "title": "STYLE_REF" }
  },
  "31": {
    "class_type": "IPAdapterUnifiedLoader",
    "inputs": {
      "model": ["10", 0],
      "preset": "PLUS (high strength)"
    },
    "_meta": { "title": "IPADAPTER_LOADER" }
  },
  "32": {
    "class_type": "IPAdapterAdvanced",
    "inputs": {
      "model": ["31", 0],
      "ipadapter": ["31", 1],
      "image": ["30", 0],
      "weight": 0.55,
      "weight_type": "style transfer",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 0.85,
      "embeds_scaling": "V only"
    },
    "_meta": { "title": "IPADAPTER" }
  },
  "40": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 88001 },
    "_meta": { "title": "SEED" }
  },
  "41": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["32", 0],
      "scheduler": "simple",
      "steps": 30,
      "denoise": 1.0
    },
    "_meta": { "title": "SCHEDULER" }
  },
  "42": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" },
    "_meta": { "title": "SAMPLER" }
  },
  "43": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["32", 0],
      "conditioning": ["20", 0]
    },
    "_meta": { "title": "GUIDER" }
  },
  "50": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["40", 0],
      "guider": ["43", 0],
      "sampler": ["42", 0],
      "sigmas": ["41", 0],
      "latent_image": ["5", 0]
    },
    "_meta": { "title": "K_SAMPLER" }
  },
  "60": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["50", 0],
      "vae": ["12", 0]
    },
    "_meta": { "title": "VAE_DECODE" }
  },
  "70": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["60", 0],
      "filename_prefix": "danslab_character"
    },
    "_meta": { "title": "SAVE" }
  }
}
