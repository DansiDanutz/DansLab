# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LLM Providers (at least one required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GLM_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=

# Local LLM
OLLAMA_HOST=http://127.0.0.1:11434

# Media Generation
FAL_API_KEY=
HIGGSFIELD_API_KEY=
ELEVENLABS_API_KEY=
COMFY_CLOUD_API_KEY=

# Research / Search
PERPLEXITY_API_KEY=
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Internal
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_REMOTE_TOKEN=
PAPERCLIP_API_KEY=

# Pipeline Config
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=glm,ollama
RENDER_PRIMARY_ENGINE=hyperframes
TTS_PRIMARY_ENGINE=kokoro
PIPELINE_HUMAN_REVIEW_GATE=true
PIPELINE_COST_BUDGET_USD=5.0
OBS_ENABLED=true

# Pipeline API Auth (REQUIRED for /api/pipeline/* routes)
# Generate with: openssl rand -hex 32
# Min length: 16 chars. Routes return 501 if unset, 401 if mismatched.
PIPELINE_API_TOKEN=

# Redis (REQUIRED for docker-compose)
# Generate with: openssl rand -hex 32
# docker-compose will refuse to start if unset.
REDIS_PASSWORD=
# Client connection URL — use this in code instead of REDIS_HOST/PORT
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379/0

# Rate limiting on /api/pipeline/* (per-token + per-IP composite key)
# Default: 60 requests per minute. Tune for your traffic.
PIPELINE_RATE_LIMIT_PER_MIN=60
PIPELINE_RATE_LIMIT_WINDOW_MS=60000

# OpenClaw Logger (REQUIRED for packages/openclaw-logger deployment)
# Used by scripts/deploy-all.sh to push the fleet logger to droplets.
# OPENCLAW_SUPABASE_URL is the Supabase project URL.
# OPENCLAW_SUPABASE_KEY is the service-role key (NOT the anon key).
OPENCLAW_SUPABASE_URL=
OPENCLAW_SUPABASE_KEY=
