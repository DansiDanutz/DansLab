HIGGSFIELD_API_KEY=
ELEVENLABS_API_KEY=
COMFY_CLOUD_API_KEY=

# Research / Search
PERPLEXITY_API_KEY=
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Internal
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_REMOTE_TOKEN=
